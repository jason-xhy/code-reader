{
  "name": "code-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Git source reader with line history and LLM explanations",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:vendor": "node scripts/build-editor.mjs",
    "test:llm": "node scripts/llm-anthropic-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test:keyboard": "node scripts/keyboard-regression.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "node scripts/check-syntax.mjs",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "three": "^0.180.0",
    "undici": "^6.29.1",
    "ws": "^8.23.0"
  }
}
